{
  "name": "@ezpg/web-ui",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "build": "tsdown && npm run build:css && tsx scripts/check-dist.ts",
    "typecheck": "tsc --noEmit",
    "manifest": "tsx scripts/build-manifest.ts",
    "build:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --minify",
    "dev:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --watch",
    "test": "vitest run",
    "sync:contracts": "tsx scripts/sync-contracts.ts",
    "check:consumer": "scripts/check-consumer.sh"
  },
  "peerDependencies": {
    "next": ">=16",
    "radix-ui": "^1.4.0",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^26.1.0",
    "next": "^16.4.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  }
}
