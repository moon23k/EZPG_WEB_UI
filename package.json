{
  "name": "@ezpg/web-ui",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core.ts",
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./styles.css": {
      "default": "./dist/styles.css"
    },
    "./tokens.css": {
      "default": "./dist/tokens.css"
    },
    "./manifest.json": "./manifest.json"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "scripts": {
    "build": "npm run manifest && tsdown --out-dir .dist-next && OUT=.dist-next npm run build:css && OUT=.dist-next tsx scripts/check-dist.ts && node scripts/swap-dist.mjs",
    "typecheck": "tsc --noEmit",
    "manifest": "tsx scripts/build-manifest.ts",
    "build:css": "tailwindcss -i src/styles/index.css -o ${OUT:-dist}/styles.css --minify && cat src/styles/system.css src/styles/semantic.css src/styles/console.css > ${OUT:-dist}/tokens.css",
    "dev": "npm run dev:css & tsdown --watch --no-clean",
    "dev:css": "tailwindcss -i src/styles/index.css -o dist/styles.css --watch",
    "test": "vitest run",
    "sync:contracts": "tsx scripts/sync-contracts.ts",
    "check:consumer": "scripts/check-consumer.sh",
    "lint": "eslint",
    "release": "npm run build && changeset publish",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@storybook/nextjs-vite": "10.6.3",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "jsdom": "^26.1.0",
    "next": "^16.4.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.3",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-ui": "^1.8.1",
    "tailwind-merge": "^3.7.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moon23k/EZPG_WEB_UI.git"
  }
}
